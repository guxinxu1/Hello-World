{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/lib/modules/6.8.0-87-generic/build/include/**",
                "/lib/modules/6.8.0-87-generic/build/include/generated/**",
                "/lib/modules/6.8.0-87-generic/build/arch/x86/include/**",
                "/usr/src/linux-hwe-6.8-headers-6.8.0-87/include/**",
                "/usr/src/linux-hwe-6.8-headers-6.8.0-87/include/asm-generic/**",
                "/usr/src/linux-headers-6.8.0-87-generic/include/**",
                "/usr/src/linux-headers-6.8.0-87-generic/arch/x86/include/generated/**",
                "/usr/src/linux-headers-6.8.0-87-generic/include/asm-generic/**",
                "/usr/include/**",
                "/usr/include/linux/**"
            ],
            "defines": [
                "__KERNEL__",
                "MODULE"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/**",
                    "/lib/modules/*/build/include/**",
                    "/usr/src/linux-headers-*/include/**",
                    "/usr/include/**"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "forcedInclude": [],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu17",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
